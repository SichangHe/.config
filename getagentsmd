#!/usr/bin/env python3
from os import environ
from pathlib import Path

from requests import get

AGENTS_MD_URL = "https://raw.githubusercontent.com/SichangHe/sichanghe.github.io/refs/heads/main/src/notes/automation_software/AGENTS.md"
ENV_FILE = Path(__file__).resolve().parent / ".env"


def load_env_var(name: str, env_file: Path = ENV_FILE) -> str | None:
    if name in environ:
        return environ[name]

    try:
        lines = env_file.read_text().splitlines()
    except (FileNotFoundError, OSError, UnicodeDecodeError):
        return None

    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue

        key, value = stripped.split("=", 1)
        if key.strip() != name:
            continue

        return value.strip().strip('"').strip("'")

    return None


def main():
    response = get(AGENTS_MD_URL)
    if response.status_code == 200:
        print(response.text)
        notes_dir = load_env_var("NOTES_DIR")
        if notes_dir:
            print(f"The human's notes are at {notes_dir}, for you reference")
    else:
        print(f"Failed to fetch AGENTS.md. Report to the user: {response}")


main() if __name__ == "__main__" else None
