        "openrouter/qwen/qwen3-next-80b-a3b-instruct:free"
      ],
      "model": "openai/gpt-5.5",
      "variant": "high"
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": true,
