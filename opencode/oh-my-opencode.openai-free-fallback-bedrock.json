{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "median",
      "fallback_models": [
        "github-copilot/gpt-5.5",
        "amazon-bedrock/anthropic.claude-sonnet-4-6",
        "cursor-acp/composer-2.5",
        "openrouter/openai/gpt-oss-120b:free",
        "openrouter/qwen/qwen3-next-80b-a3b-instruct:free"
      ],
      "prompt_append": "When calling subagents, You MUST choose which agent to use instead of calling yourself. Discuss all key decision/analysis with the most intelligent subagent. Let low-tier subagents do the bulk of the work. After implementing non-trivial code changes, you MUST call the `reviewer` subagent via task() with the diff and relevant files before responding. Do NOT tell the reviewer exactly what you implemented, ask it to infer it and see if it matches you goal. If the reviewer reports reasonable issues, fix them and re-run the reviewer. You may ignore nitpicks as you see fit. Do not call the reviewer if you made no or trivial edits."
    },
    "hephaestus": {
      "fallback_models": [
        "github-copilot/gpt-5.5",
        "amazon-bedrock/anthropic.claude-sonnet-4-6",
        "cursor-acp/composer-2.5",
        "openrouter/openai/gpt-oss-120b:free",
        "openrouter/qwen/qwen3-next-80b-a3b-instruct:free"
      ],
      "variant": "median",
      "model": "openai/gpt-5.5",
      "prompt_append": "When calling subagents, You MUST choose which agent to use instead of calling yourself. Discuss all key decision/analysis with the most intelligent subagent. Let low-tier subagents do the bulk of the work. After implementing non-trivial code changes, you MUST call the `reviewer` subagent via task() with the diff and relevant files before responding. Do NOT tell the reviewer exactly what you implemented, ask it to infer it and see if it matches you goal. If the reviewer reports reasonable issues, fix them and re-run the reviewer. You may ignore nitpicks as you see fit. Do not call the reviewer if you made no or trivial edits."
    },
    "oracle": {
      "model": "amazon-bedrock/zai.glm-4.7"
    },
    "librarian": {
      "model": "amazon-bedrock/zai.glm-4.7"
    },
    "explore": {
      "fallback_models": [
        "github-copilot/gpt-5.5",
        "amazon-bedrock/anthropic.claude-sonnet-4-6",
        "cursor-acp/composer-2.5",
        "openrouter/openai/gpt-oss-120b:free",
        "openrouter/qwen/qwen3-next-80b-a3b-instruct:free"
      ],
      "model": "openai/gpt-5.5"
    },
    "multimodal-looker": {
      "fallback_models": [
        "openrouter/openai/gpt-oss-120b:free",
        "openrouter/qwen/qwen3-next-80b-a3b-instruct:free"
      ],
      "model": "cursor-acp/composer-2.5",
      "mode": "all"
    },
    "prometheus": {
