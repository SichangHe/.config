{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "agents": {
    "sisyphus": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "hephaestus": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "oracle": {
      "model": "github-copilot/gpt-5.2",
      "variant": "xhigh",
      "mode": "all"
    },
    "librarian": {
      "model": "github-copilot/gpt-5.2-codex",
      "mode": "all"
    },
    "explore": {
      "model": "github-copilot/gpt-5.2-codex",
      "mode": "all"
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-3-pro",
      "mode": "all"
    },
    "prometheus": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "metis": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh",
      "mode": "all"
    },
    "momus": {
      "model": "github-copilot/gpt-5.2",
      "variant": "xhigh",
      "mode": "all"
    },
    "atlas": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "medium"
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": false
  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3-pro"
    },
    "ultrabrain": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "deep": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "artistry": {
      "model": "google/antigravity-gemini-3-pro"
    },
    "quick": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "low"
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "low"
    },
    "unspecified-high": {
      "model": "github-copilot/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "writing": {
      "model": "google/antigravity-gemini-3-pro"
    }
  }
}
