[user]
	name = Steven Hé (Sīchàng)
	email = stevensichanghe@gmail.com
[init]
	defaultBranch = main
[core]
    pager = delta
	autocrlf = input
[interactive]
    diffFilter = delta --color-only
[add.interactive]
    useBuiltin = false # required for git 2.37.0
[delta]
    navigate = true    # use n and N to move between diff sections
    light = true
    side-by-side = true
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[submodule]
	recurse = true
[lfs]
	locksverify = false
[credential]
	helper = store
[safe]
	directory = *
