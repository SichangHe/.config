# Copy to ~/.config/omo_manager/local.env and edit for this machine.
export OMO_WORK_LOGS_ROOT="$HOME/work_logs"
export OMO_MANAGER_TMUX_TARGET="omo-manager:0.0"
# Untagged human email goes here; the main manager above remains the fallback.
export DEFAULT_CONTACT_AGENT="human-contact:0.0"
# The agent Gmail account sends to the human and receives human replies.
export OMO_AGENT_GMAIL_ADDRESS="agent-account@gmail.com"
export OMO_AGENT_GMAIL_APP_PASSWORD="replace-with-agent-app-password"
export OMO_HUMAN_EMAIL_ADDRESS="human-account@gmail.com"
# Optional; this is already the default for human-mail cleanup access.
# export OMO_HUMAN_EMAIL_CONFIG_PATH="$HOME/.config/himalaya/config.toml"
