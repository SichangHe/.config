# Copy to ~/.config/omo_manager/local.env and edit for this machine.
export OMO_WORK_LOGS_ROOT="$HOME/work_logs"
export OMO_MANAGER_URL="http://127.0.0.1:18790"
export OMO_MANAGER_STATE_DIR="/tmp/omo-manager"
export OMO_MANAGER_PENDING_SEEN="/tmp/omo-manager-pending-seen.tsv"
export OMO_MANAGER_MAIL_DIR="/tmp/omo-manager-mail"
